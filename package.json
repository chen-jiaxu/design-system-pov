    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "vite": "^8.0.4",
    "vitest": "^5.1.0"
  }
}
